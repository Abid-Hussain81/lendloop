# Copy to .env.local. Populate from your own Clerk and Convex development apps.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Written by `npx convex dev`; leave blank until selecting your deployment.
CONVEX_DEPLOYMENT=

# Set these in the Convex deployment environment, NOT only in .env.local:
# CLERK_JWT_ISSUER_DOMAIN=https://YOUR-APP.clerk.accounts.dev
# ADMIN_CLERK_USER_IDS=user_YOUR_ADMIN_ID
# CONVEX_TO_N8N_SECRET=an-independent-random-secret-at-least-32-characters
# N8N_TO_CONVEX_SECRET=another-independent-random-secret-at-least-32-characters
# N8N_WEBHOOK_URL=https://YOUR-WEBHOOK-HOST/webhook/lendloop-request
