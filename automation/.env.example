# Copy to automation/.env; all real values remain git-ignored.
# Generate independent secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
CONVEX_SITE_URL=https://YOUR-DEPLOYMENT.convex.site
N8N_WEBHOOK_PATH=/webhook/lendloop-request
# Public HTTPS tunnel base URL, ending with /. Forward webhook paths only.
WEBHOOK_URL=https://YOUR-WEBHOOK-HOST/
